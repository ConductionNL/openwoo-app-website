# Server block for the static Docusaurus build. Rendered by the nginx
# image's envsubst entrypoint (no variables here, but keeping the
# .template flow means adding one later needs no Dockerfile change).
server {
    listen       8080;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    include /etc/nginx/conf.d/includes/security-headers.conf;

    # Compress text assets on the fly
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Webpack assets are content-hashed: cache them hard. add_header here
    # discards inherited headers, so re-include the security set.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/conf.d/includes/security-headers.conf;
        try_files $uri =404;
    }

    # Docusaurus builds with trailingSlash: true — every route is a
    # directory with an index.html.
    location / {
        try_files $uri $uri/index.html =404;
    }

    error_page 404 /404.html;
}
