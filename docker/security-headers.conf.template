# Security headers, defined once and included by default.conf's server{}
# and by every location{} that declares add_header of its own (nginx
# discards ALL inherited add_header directives the moment a block adds one).
#
# This template lives in templates/includes/ so its output lands in
# /etc/nginx/conf.d/includes/ — outside the conf.d/*.conf glob nginx.conf
# auto-includes — and is only pulled in via explicit include directives.
#
# - FRAME_ANCESTORS defaults to 'none' (Dockerfile ENV); override at runtime
#   if the docs site ever needs to be embedded in a portal iframe.
# - HSTS: TLS terminates at the ingress/Cloudflare, the header just passes
#   through to the browser; on plain-HTTP responses browsers ignore it.
add_header Content-Security-Policy "frame-ancestors ${FRAME_ANCESTORS}" always;
add_header X-Content-Type-Options nosniff always;
add_header Referrer-Policy strict-origin-when-cross-origin always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
add_header Strict-Transport-Security "max-age=31536000" always;
